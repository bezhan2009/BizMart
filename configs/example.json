{
  "log_params": {
    "log_directory": "logs",
    "log_info": "info.log",
    "log_error": "error.log",
    "log_warn": "warn.log",
    "log_debug": "debug.log",
    "max_size_megabytes": 10,
    "max_backups": 4,
    "max_age": 30,
    "compress": true,
    "local_time": true
  },
  "app_params": {
    "gin_mode": "release",
    "port_run": "8181",
    "server_url": "localhost",
    "server_name": "BizMart_service",
    "env": "localhost"
  },
  "postgres_params": {
    "host": "db",
    "port": "5432",
    "user": "postgres",
    "database": "biz_mart_db",
    "sslmode": "disable"
  },
  "auth_params": {
    "jwt_secret_key": "",
    "jwt_ttl_minutes": 60
  },
  "clients": {
    "sso": {
      "address": "grpc_server:44044",
      "timeout": "1s",
      "retries_count": 5,
      "insecure": true
    }
  }
}
